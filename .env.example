# ============================================================================
# AI YouTube Automation — environment configuration
# Copy to .env and fill in. Everything with a sane default can be left blank.
# ============================================================================

# --- App ---
APP_ENV=development                # development | production
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Security (JWT) ---  CHANGE THESE
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Bootstrapped on first startup so you can log in immediately.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me

# --- Database ---
# DATABASE_URL wins over the POSTGRES_* settings below when set.
#
# Local dev (no server to install):
#   DATABASE_URL=sqlite:///./yt_dev.db
#
# Supabase — copy from: Project Settings > Database > Connection string > URI.
# Pick the SESSION POOLER (port 5432). Three reasons the other options bite:
#   * "Direct connection" (db.<ref>.supabase.co) is IPv6-only. Most home ISPs and
#     Windows boxes can't reach it and you get a confusing DNS/timeout error.
#   * "Transaction pooler" (port 6543) can't run Alembic migrations reliably
#     (no advisory locks / prepared statements). The app auto-detects it and
#     disables prepared statements, but migrations should not use it.
#   * Session pooler is IPv4 and behaves like a normal Postgres connection.
# Remember to URL-encode special characters in the password (@ -> %40, etc).
#
#   DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# NOTE: keep the "+psycopg" driver prefix — Supabase's copy button omits it.
# NOTE: the free tier pauses a project after ~1 week with no activity.
DATABASE_URL=sqlite:///./yt_dev.db

# --- Database (PostgreSQL — used only when DATABASE_URL is empty) ---
POSTGRES_USER=yt
POSTGRES_PASSWORD=yt
POSTGRES_DB=yt_automation
POSTGRES_HOST=localhost            # 'db' inside docker-compose
POSTGRES_PORT=5432

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://localhost:6379/0   # 'redis://redis:6379/0' inside docker-compose

# --- LLM: OpenRouter (free-tier models supported) ---
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ONE key above serves ALL models below. This is a MODEL fallback chain (not keys):
# the client retries the next model when one is rate-limited/errors. Order = best first.
# Verify live free IDs at https://openrouter.ai/models?max_price=0 (they change over time).
# Note: the :free daily cap is per-ACCOUNT and shared across all :free models. For true 24/7,
# append a cheap NON-:free model as the last link (pennies/month) so the chain never dead-ends.
LLM_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,poolside/laguna-s-2.1:free,cohere/north-mini-code:free
# The chain above was verified live with scripts/check_llm.py. Re-run that script if models 404.
# NOTE: this chain serves SHORTS. Long-form runs (--format long) swap in LLM_MODELS_LONG
# below, because their larger prompts need a different order — see config.py.
# Avoid *reasoning* models here (all nvidia/nemotron-3-* were tested and rejected): they emit
# chain-of-thought into the response body, e.g. "We need to output only narration text...",
# which ends up narrated in your video. Only add a model after check_llm.py shows clean prose.
# For true 24/7, append a cheap NON-:free model as the final link (~$1-2/mo, same key), e.g.:
# LLM_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,<cheap-paid-model>
LLM_TEMPERATURE=0.7
# Wall-clock ceiling for ONE logical chat() — every model in the chain, every retry
# sweep. Without it the per-request timeout multiplies out (4 models x 3 sweeps x
# 120s = 24 min for a single judge call). One such call burned 50 minutes on
# 2026-08-13 and CI cancelled the job mid-render with nothing published.
LLM_CHAT_BUDGET_SECONDS=420

# --- LLM: Gemini (used ONLY for long-form videos, on its own free tier) ---
# Get a free key at https://aistudio.google.com/apikey
# run_daily switches to Gemini automatically for `--format long` when this is set;
# Shorts always stay on OpenRouter, so the two never share a request budget.
LLM_PROVIDER=openrouter            # openrouter | gemini (run_daily overrides for long-form)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Verify current free-tier model ids at https://ai.google.dev/gemini-api/docs/models
# Google RETIRES ids rather than aliasing them forward — the 2.0/1.5 chain that used to
# be here started 404ing on every call and took long-form down with it. List what your
# key can actually reach with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.5-flash,gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=120

# --- Long-form-only LLM overrides (ignored by Shorts runs) ---
# laguna leads here because it was the only model to handle BOTH long-form jobs cleanly
# (an 850-word script and a 16-entry scene-prompt JSON, ~15s each). gemma-4-31b sits last:
# it returned 429 on every call measured. Shorts keep LLM_MODELS above untouched.
LLM_MODELS_LONG=poolside/laguna-s-2.1:free,google/gemma-4-26b-a4b-it:free,cohere/north-mini-code:free,google/gemma-4-31b-it:free
# Some free models need well over two minutes for a large JSON response (north-mini-code
# was measured at ~206s on the long-form scene prompts), so keep this generous.
LLM_TIMEOUT_SECONDS_LONG=300
LLM_CHAT_BUDGET_SECONDS_LONG=1200

# --- Script quality gate ---
# Drafts generated per video; an LLM judge then picks the strongest. 1 disables the
# gate entirely (single-shot generation). Costs SCRIPT_CANDIDATES + 1 extra LLM calls
# per video — cheap on free models, and the script drives retention and likes more
# than anything downstream.
SCRIPT_CANDIDATES=3

# --- Provider selection (free-first defaults) ---
IMAGE_PROVIDER=pollinations        # pollinations | stable_diffusion | flux | openai
TTS_PROVIDER=edge                  # edge | piper | kokoro | elevenlabs
#   edge = free, no key, 300+ neural voices, works on Windows, gives exact subtitles
SUBTITLE_PROVIDER=edge             # edge (reuse TTS timings) | faster_whisper (ASR)
TREND_PROVIDER=ai_news             # ai_news | reddit_til | wikipedia | google_trends
#   reddit_til = best for short educational 'fact' videos (verified working)
#   google_trends = news/celebrity heavy; pytrends is DEAD (404), RSS feed used instead
TREND_GEO=US                       # google_trends only

# --- Tracing (LangSmith) — optional, OFF by default ---
# Records every graph node, LLM call (with the model that actually served it after
# failover) and the script judge's verdict. No extra dependency: langchain-core
# already requires the langsmith SDK, so this is purely configuration.
# Get a key at https://smith.langchain.com -> Settings -> API Keys.
# NOTE: traces contain full prompts and generated scripts. Treat the key as a secret
# and keep the project private.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=yt-automation
LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # EU region: https://eu.api.smith.langchain.com

# --- Media storage ---
MEDIA_ROOT=./media_output

# --- Image providers (optional) ---
OPENAI_API_KEY=
STABLE_DIFFUSION_MODEL=stabilityai/stable-diffusion-xl-base-1.0
FLUX_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# --- TTS: edge-tts (default, free, keyless) ---
EDGE_TTS_VOICE=en-US-AriaNeural    # list all: python scripts/list_voices.py
EDGE_TTS_RATE=+0%                  # e.g. +10% for snappier shorts narration
EDGE_TTS_PITCH=+0Hz

# --- TTS providers (optional alternatives) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Rachel
PIPER_VOICE=en_US-amy-medium       # downloaded on first use
KOKORO_VOICE=af_sky

# --- Whisper (subtitles) ---
WHISPER_MODEL=base                 # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu                 # cpu | cuda
WHISPER_COMPUTE_TYPE=int8

# --- Video defaults ---
SHORTS_WIDTH=1080
SHORTS_HEIGHT=1920
LONGFORM_WIDTH=1920
LONGFORM_HEIGHT=1080
VIDEO_FPS=30

# How often the picture changes. Scene count is derived from the narration's own
# length, so these set the cut rhythm rather than a fixed number of images.
# Lowering SECONDS_PER_SCENE costs run time: images generate serially at ~35s each
# (the free Pollinations endpoint allows one request at a time), so every extra
# scene is ~35s per video against RUN_BUDGET_MINUTES.
SECONDS_PER_SCENE=5
MAX_SCENES_SHORT=12
# Long-form cuts slower for a load-bearing reason — see config.py before changing.
SECONDS_PER_SCENE_LONG=20
MAX_SCENES_LONG=16

# Word-by-word karaoke captions (ASS/libass) instead of static SRT blocks. Falls
# back to SRT automatically when the TTS provider supplies no word timings.
ANIMATED_CAPTIONS=true
# Fonts committed to the repo so a render looks identical on a dev machine and on a
# CI runner (they share almost no system fonts). Empty folder = OS fonts.
CAPTION_FONT_DIR=./assets/fonts
# Background music bed. Tracks live in assets/music/<content_type>/; a content type
# with no tracks simply gets no music. Regenerate the synthesized beds with
# `python scripts/make_music_beds.py`, or drop real tracks in (see that folder's README).
MUSIC_DIR=./assets/music
MUSIC_VOLUME=0.12                  # fraction of full scale; keep well under the voice
# The finished mix is normalized to -14 LUFS (YouTube's playback target) after the
# music bed goes in. Not configurable — -14 is a property of the platform, not a
# taste — see LOUDNESS_TARGET_LUFS in backend/app/media/video/__init__.py.

# --- YouTube Data API (publishing) ---
# OAuth client from https://console.cloud.google.com (YouTube Data API v3 enabled).
# Place client secrets JSON path here; token is created via the /publish/authorize flow.
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json
YOUTUBE_UPLOAD_PRIVACY=private     # private | unlisted | public  (start private!)

# Language of the metadata and the narration. Sent as defaultLanguage +
# defaultAudioLanguage, the most direct signal YouTube has for routing a video to
# an English-speaking audience. Leave empty to send neither (the old behavior).
YOUTUBE_DEFAULT_LANGUAGE=en-US

# Exact UTC "HH:MM" the run's videos should go live. When set, uploads go up
# private with status.publishAt and YouTube publishes them itself at that instant,
# so GitHub Actions queue delay (measured as high as +2h39m) stops moving the
# publish time. Empty = publish immediately on upload. Set per workflow.
YOUTUBE_PUBLISH_SLOT=
YOUTUBE_PUBLISH_STAGGER_MINUTES=15 # gap between videos within one run
YOUTUBE_PUBLISH_MAX_LEAD_HOURS=6   # slot further away than this => publish now

# categoryId per content type. News is Science & Technology (28); the themed
# streams are People & Blogs (22).
YOUTUBE_CATEGORY_IDS=news:28,dev_humor:22,code_heartbreak:22

# Plain API key (Google Cloud > Credentials > API key, restricted to YouTube Data
# API v3). Reads PUBLIC view/like/comment counts for the performance feedback loop.
# Separate from OAuth on purpose, and the two cover different halves of the loop:
# this key cannot read geography, and the OAuth token cannot read arbitrary videos'
# public stats. Country data needs the OAuth token to carry yt-analytics.readonly —
# mint it with `python scripts/youtube_auth.py`.
YOUTUBE_API_KEY=

# --- Feedback-loop state ---
# Committed JSON (published ledger, seen-topic dedupe, measured performance) rather
# than the DB, because CI runners are ephemeral — the repo is the channel's memory.
STATE_DIR=./state

# --- Scheduler ---
# Daily news cadence. 06:00 UTC = 11:30 IST — morning stories, predictable slot.
DISCOVER_DAILY=true
DISCOVER_AT_HOUR=6
DISCOVER_AT_MINUTE=0
DISCOVER_CRON_HOURS=6              # only used when DISCOVER_DAILY=false
AUTO_GENERATE=true                 # auto-run full pipeline on discovered topics
# YouTube allows ~6 uploads/day (10k quota / ~1600 per upload). 2 keeps you well
# inside that and inside OpenRouter's free daily request cap.
MAX_TOPICS_PER_RUN=2
# Wall-clock budget for one scripts/run_daily.py run, kept under the CI job's
# timeout-minutes. A job GitHub cancels publishes nothing and uploads no artifact;
# stopping ourselves first means whatever already rendered still gets uploaded.
RUN_BUDGET_MINUTES=50

# Parallel image requests. Pollinations allows only ONE concurrent request per IP
# (measured: 4 workers -> 1/7 images real; sequential -> 4/4). Keep at 1 unless
# you switch to a provider that supports concurrency.
IMAGE_CONCURRENCY=1
